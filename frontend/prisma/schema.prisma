generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider  = "postgresql"
    url       = env("DATABASE_URL")
    directUrl = env("DIRECT_URL")
}

model TelegramBinding {
    id             String    @id
    chatId         String    @unique @map("chat_id")
    walletAddress  String    @map("wallet_address")
    status         String
    createdAt      DateTime  @map("created_at")
    updatedAt      DateTime  @map("updated_at")
    lastVerifiedAt DateTime? @map("last_verified_at")

    @@index([walletAddress], map: "idx_telegram_bindings_wallet")
    @@map("telegram_bindings")
}

model TelegramBindingToken {
    tokenHash     String    @id @map("token_hash")
    chatId        String    @map("chat_id")
    walletAddress String    @map("wallet_address")
    createdAt     DateTime  @map("created_at")
    expiresAt     DateTime  @map("expires_at")
    usedAt        DateTime? @map("used_at")

    @@index([chatId], map: "idx_telegram_binding_tokens_chat")
    @@index([walletAddress], map: "idx_telegram_binding_tokens_wallet")
    @@map("telegram_binding_tokens")
}

model DispatchJob {
    id                     String   @id
    caption                String
    templateName           String?  @map("template_name")
    templateLanguageCode   String?  @map("template_language_code")
    templateBodyParameters Json?    @map("template_body_parameters")
    templateHeaderImageUrl String?  @map("template_header_image_url")
    postType               String   @map("post_type")
    brief                  String
    tone                   String
    photos                 Json
    hasCeloPayment         Boolean  @default(false) @map("has_celo_payment")
    price                  String
    currency               String
    waAccount              String   @map("wa_account")
    sendTime               String   @map("send_time")
    repeatValue            String   @map("repeat_value")
    scheduledFor           DateTime @map("scheduled_for")
    targets                Json
    status                 String
    createdAt              DateTime @map("created_at")
    updatedAt              DateTime @map("updated_at")
    attemptCount           Int      @default(0) @map("attempt_count")
    lastError              String?  @map("last_error")
    messageIds             Json?    @map("message_ids")
    ownerChatId            String?  @map("owner_chat_id")
    ownerWalletAddress     String?  @map("owner_wallet_address")
    idempotencyKey         String?  @unique @map("idempotency_key")

    receipts DispatchReceipt[]

    @@index([status, scheduledFor], map: "idx_dispatch_jobs_status_time")
    @@index([ownerChatId], map: "idx_dispatch_jobs_owner_chat")
    @@index([ownerWalletAddress], map: "idx_dispatch_jobs_owner_wallet")
    @@map("dispatch_jobs")
}

model DispatchReceipt {
    id          String   @id
    jobId       String   @map("job_id")
    provider    String
    targetId    String   @map("target_id")
    recipient   String?
    status      String
    messageId   String?  @map("message_id")
    error       String?
    attemptedAt DateTime @map("attempted_at")

    job DispatchJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

    @@index([jobId], map: "idx_dispatch_receipts_job")
    @@map("dispatch_receipts")
}

model WhatsAppWebhookEvent {
    id         String   @id
    receivedAt DateTime @map("received_at")
    payload    Json

    @@index([receivedAt], map: "idx_whatsapp_webhook_events_received_at")
    @@map("whatsapp_webhook_events")
}

model WalletAuthChallenge {
    nonce         String    @id
    walletAddress String    @map("wallet_address")
    chatId        String?   @map("chat_id")
    message       String
    createdAt     DateTime  @map("created_at")
    expiresAt     DateTime  @map("expires_at")
    usedAt        DateTime? @map("used_at")

    @@index([walletAddress, createdAt], map: "idx_wallet_auth_challenges_wallet")
    @@map("wallet_auth_challenges")
}

model WalletAuthSession {
    tokenHash     String    @id @map("token_hash")
    walletAddress String    @map("wallet_address")
    chatId        String?   @map("chat_id")
    createdAt     DateTime  @map("created_at")
    expiresAt     DateTime  @map("expires_at")
    lastUsedAt    DateTime? @map("last_used_at")
    revokedAt     DateTime? @map("revoked_at")

    @@index([walletAddress, expiresAt], map: "idx_wallet_auth_sessions_wallet")
    @@map("wallet_auth_sessions")
}

model PaymentTransaction {
    id                 String    @id
    txHash             String    @unique @map("tx_hash")
    chainId            Int       @default(11142220) @map("chain_id")
    contractAddress    String    @map("contract_address")
    buyer              String
    seller             String
    tokenAddress       String    @map("token_address")
    amount             String
    currency           String
    productId          String    @map("product_id")
    productName        String    @map("product_name")
    escrowId           Int?      @map("escrow_id")
    escrowStatus       String    @default("pending") @map("escrow_status")
    ownerWalletAddress String    @map("owner_wallet_address")
    blockNumber        BigInt?   @map("block_number")
    confirmedAt        DateTime? @map("confirmed_at")
    createdAt          DateTime  @map("created_at")
    updatedAt          DateTime  @map("updated_at")

    @@index([ownerWalletAddress, createdAt], map: "idx_payment_transactions_owner_time")
    @@index([txHash], map: "idx_payment_transactions_tx_hash")
    @@map("payment_transactions")
}
